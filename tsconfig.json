{
  "include": [
    "tests",
    "tests-navegador",
    "shared",
    "scripts/*.d.mts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
