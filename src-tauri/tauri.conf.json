{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Painel de Avaliacoes",
  "mainBinaryName": "Painel-Avaliacoes",
  "version": "1.0.0",
  "identifier": "br.com.painel.avaliacoes",
  "build": {
    "frontendDist": "vazio"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Painel de Avaliações",
    "shortDescription": "Painel de Avaliações",
    "longDescription": "Cadastro de avaliações físicas dos alunos e envio de lembretes pelo WhatsApp.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "externalBin": [
      "binarios/painel-node"
    ]
  }
}
